# clangd configuration for this ESP-IDF (v6.0.1, target: esp32 / Xtensa) project.
#
# The compilation database is generated by "idf.py build" into build/compile_commands.json
# (ESP-IDF sets CMAKE_EXPORT_COMPILE_COMMANDS=ON automatically). Rebuild after adding
# new source files or components so the database stays in sync.
#
# The picolibc header directory (<toolchain>/xtensa-esp-elf/picolibc/include) is added
# to the compile commands by the top-level CMakeLists.txt, because clang cannot read
# the toolchain's picolibc.specs file that provides these paths to GCC.

CompileFlags:
  CompilationDatabase: build

  Add:
    # The compilation database is generated for xtensa-esp32-elf-gcc, which does not
    # pass a -target flag. Without it esp-clang's clangd defaults to its native
    # riscv32-esp-elf target, so __XTENSA__ etc. are not defined and ESP-IDF headers
    # take the wrong (RISC-V) code paths. This mirrors ESP-IDF's own clang toolchain
    # files (tools/cmake/toolchain-clang-esp32.cmake).
    - --target=xtensa-esp-elf
    - -mcpu=esp32
    # esp-clang's driver performs multilib selection even for syntax-only runs;
    # IDF passes -Werror, which would turn its "no multilib found" notice into an error.
    - -Wno-missing-multilib
    # The toolchain response file (build/toolchain/cflags) contains -specs=... and
    # other GCC options that clang accepts but marks "unused"; IDF passes -Werror.
    - -Wno-unused-command-line-argument
    # GCC has warning options that clang does not know (e.g. -Wno-old-style-declaration);
    # with -Werror they would become hard errors.
    - -Wno-unknown-warning-option

  Remove:
    # GCC-only options that clang's driver rejects with "unknown argument".
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-init-padding-bits=all
    - -fno-malloc-dce
    # Cosmetic/noise for an LSP session.
    - -fdiagnostics-color=always

Diagnostics:
  # ESP-IDF headers are not maintained with IWYU, so "unused include" reports here
  # are noise. (Also overrides the strict global setting from ~/.config/clangd/config.yaml.)
  UnusedIncludes: None

Index:
  Background: Build
